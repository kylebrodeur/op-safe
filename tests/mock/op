#!/usr/bin/env python3
# test mock for `op` used by the op-safe test suite.
# Prints metadata only, EXCEPT `item get` (realistic secret values embedded so
# tests can prove they never reach stdout) and `read` (emits a secret so save
# tests can prove the value lands in the 0600 file and nowhere else).
import json
import os
import sys

ARGS = sys.argv[1:]


def mock_op_usage(*_args: str) -> None:
    print("mock-op: unhandled: " + " ".join(ARGS), file=sys.stderr)
    raise SystemExit(3)


def emit(obj: object) -> None:
    print(json.dumps(obj, indent=2))


cmd = ARGS.pop(0) if ARGS else ""

if cmd == "account":
    emit({"email": "agent@example.com", "user_uuid": "U1", "shorthand": "agents"})
elif cmd == "whoami":
    # The tool must NEVER call this. It is not a readiness check, and
    # under the desktop integration it can report "not signed in" for a
    # session that still serves items. If a test ever trips this
    # handler, the tool regressed.
    print("mock-op: whoami must not be called", file=sys.stderr)
    raise SystemExit(97)
elif cmd == "signin":
    print("signin ok")
elif cmd == "--mock-selftest":
    # The shibboleth: a marker secret that must never travel to stdout.
    print("SECRET-VALUE-shibboleth")
elif cmd == "vault":
    if ARGS and ARGS[0] == "list":
        emit([
            {"id": "v1", "name": "Team Vault"},
            {"id": "v2", "name": "Employee"},
        ])
    else:
        mock_op_usage()
elif cmd == "item":
    if ARGS and ARGS[0] == "list":
        emit([
            {"id": "i1", "title": "Posthog Key", "category": "API_CREDENTIAL",
             "vault": {"id": "v1", "name": "Team Vault"}},
            {"id": "i2", "title": "Deploy Token", "category": "API_CREDENTIAL",
             "vault": {"id": "v1", "name": "Team Vault"}},
        ])
    elif ARGS and ARGS[0] == "get":
        item = ARGS[1] if len(ARGS) > 1 else ""
        if item in ("Posthog Key", "i1"):
            emit({
                "id": "i1", "title": "Posthog Key",
                "category": "API_CREDENTIAL",
                "vault": {"id": "v1", "name": "Team Vault"},
                "fields": [
                    {"id": "password", "label": "Project API Key",
                     "type": "CONCEALED", "value": "SECRET-posthog",
                     "section": {"id": "", "label": ""}},
                    {"id": "note", "label": "Usage Note",
                     "type": "STRING", "value": "rotate monthly",
                     "section": {"id": "", "label": ""}},
                ],
            })
        elif item in ("Deploy Token", "i2"):
            emit({
                "id": "i2", "title": "Deploy Token",
                "category": "API_CREDENTIAL",
                "vault": {"id": "v2", "name": "Employee"},
                "fields": [
                    {"id": "credential", "label": "SSH Key",
                     "type": "SSHKEY", "value": "SECRET-ssh"},
                ],
            })
        elif item == "Bad Item":
            print("mock-op: item not found: " + item, file=sys.stderr)
            raise SystemExit(1)
        else:
            mock_op_usage()
    else:
        mock_op_usage()
elif cmd == "read":
    ref = ARGS[0] if ARGS else ""
    if "Missing Item" in ref:
        print("mock-op: item not found: " + ref, file=sys.stderr)
        raise SystemExit(1)
    print("SECRET-VALUE-" + ref.replace("/", "__").replace(":", "_"))
else:
    mock_op_usage()